# =============================================================================
# Nexus Intelligence Agent — 环境变量配置
# 复制此文件为 .env 并按需修改
# =============================================================================

# ── LLM 提供方 ──────────────────────────────────────────────────────────
# 可选: deepseek | openai | qwen | ollama
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# OpenAI（可选）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_MODEL=gpt-4o-mini

# 阿里云通义千问（可选）
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_LLM_MODEL=qwen-plus

# Ollama 本地（可选）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen2:7b-instruct

# ── Embedding ───────────────────────────────────────────────────────────
# 可选: bge-m3 | deepseek | openai
EMBED_PROVIDER=bge-m3
EMBED_MODEL=bge-m3

# ── 向量存储 ────────────────────────────────────────────────────────────
# 可选: qdrant | faiss
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nia_vectors
# FAISS_INDEX_PATH=./data/faiss_index

# ── 基础设施 ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
MONGO_DB=nia

# ── CORS ────────────────────────────────────────────────────────────────
# 生产环境请设置为具体域名，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── AI 参数 ────────────────────────────────────────────────────────────
AI_CACHE_DAYS=7
EXTRACTION_FAILURE_THRESHOLD=0.3
DOM_SIMILARITY_THRESHOLD=0.7
# RAG 检索相似度阈值，低于此值用普通聊天
RAG_THRESHOLD=0.3

# ── 日志 ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
