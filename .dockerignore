# =============================================================================
# 构建上下文排除清单 —— 重要：backend/.env 里有真实 API Key，
# 如果不排除会被 COPY backend/ . 打进镜像层。
# =============================================================================

# 机密 & 环境
**/.env
**/.env.*
!**/.env.example
.env
.env.*

# 依赖 & 构建产物（镜像内会重新安装/构建）
**/node_modules
**/dist
**/build
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/*.egg-info

# 运行时数据（索引、模型缓存、日志）
backend/data
backend/nia/_data
faiss_index
**/logs
**/*.log

# 开发工具
.git
.gitignore
.github
.vscode
.idea
.claude
*.tmp
*.bak
*.docx

# 文档（容器内不需要）
README.md
运行步骤.md
docker-compose.yml
Dockerfile
