# ── LLM Provider ──────────────────────────────────────────────────
# 可选值: deepseek | openai | qwen | ollama
LLM_PROVIDER=deepseek

# DeepSeek (推荐，便宜，中文强)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# OpenAI (备选)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_MODEL=gpt-4o-mini

# Qwen 阿里云通义 (备选)
# QWEN_API_KEY=your-qwen-api-key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_LLM_MODEL=qwen-plus

# Ollama 本地 (如需保留)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen2:7b-instruct

# ── Embedding ─────────────────────────────────────────────────────
# 可选值: fastembed (本地ONNX, CPU即可, 推荐) | bge-m3 (本地Ollama) | openai
# fastembed 首次会自动下载模型并缓存, 之后离线可用; bge-m3 = 1024 维, 与 FAISS 对齐
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ── Vector Store ──────────────────────────────────────────────────
# 可选值: faiss (本地, 推荐) | qdrant (需 Docker)
VECTOR_STORE=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nia_vectors

# ── 基础设施 ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
MONGO_DB=nia

# ── AI 配置 ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
AI_CACHE_DAYS=7
EXTRACTION_FAILURE_THRESHOLD=0.3
DOM_SIMILARITY_THRESHOLD=0.7
RAG_THRESHOLD=0.3

# ── 并发爬取引擎 ──────────────────────────────────────────────────
CRAWL_CONCURRENCY=8
CRAWL_LLM_CONCURRENCY=4
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=2

# ── 自主爬取 Agent ────────────────────────────────────────────────
AGENT_MAX_PAGES=30
AGENT_MAX_STEPS=20
