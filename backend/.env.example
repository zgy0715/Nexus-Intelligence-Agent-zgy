# =============================================================================
# Nexus Intelligence Agent — 后端环境变量
# 复制为 backend/.env 后按需修改：  cp .env.example .env
# 只需填写 DEEPSEEK_API_KEY，其余保持默认即可跑起来（仅依赖 Redis + MongoDB）
# =============================================================================

# ── LLM Provider ──────────────────────────────────────────────────
# 可选值: deepseek | openai | qwen | ollama
LLM_PROVIDER=deepseek

# DeepSeek (推荐，便宜，中文强)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# OpenAI (备选)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_MODEL=gpt-4o-mini

# Qwen 阿里云通义 (备选)
# QWEN_API_KEY=your-qwen-api-key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_LLM_MODEL=qwen-plus

# Ollama 本地 (备选)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen2:7b-instruct

# ── Embedding ─────────────────────────────────────────────────────
# 可选值: fastembed (本地ONNX, CPU即可, 推荐) | bge-m3 (本地Ollama) | openai
# 注意: fastembed 只支持它自己内置的模型 id, 其中【没有】BAAI/bge-m3。
#       查询可用列表:
#         python -c "from fastembed import TextEmbedding; print([m['model'] for m in TextEmbedding.list_supported_models()])"
#       中文语料推荐 BAAI/bge-small-zh-v1.5 (512 维, 约 90MB, CPU 快)
#       多语种高质量可选 intfloat/multilingual-e5-large (1024 维, 约 2.2GB, 较慢)
#       首次使用会自动下载模型并缓存, 之后离线可用。
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 留空/不写 = 按 EMBED_MODEL 自动推导维度；换模型后无需手动改
# EMBED_DIM=512
# 模型缓存目录（相对 backend/）。必须显式指定：否则 fastembed 会用临时目录，
# 进程退出即被清理，每次启动都要重新下载模型。
FASTEMBED_CACHE_DIR=./data/fastembed
# 国内网络访问 huggingface.co 超时/失败时，改用镜像（也可用 hf-mirror 手动下载后
# 把 EMBED_MODEL 指向本地模型目录，例如 EMBED_MODEL=./data/fastembed/bge-small-zh-v1.5）
# HF_ENDPOINT=https://hf-mirror.com

# ── Vector Store ──────────────────────────────────────────────────
# 可选值: faiss (本地, 推荐, 无需额外依赖) | qdrant (需自行安装 qdrant-client)
VECTOR_STORE=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nia_vectors
# FAISS 索引目录；不填则用 backend/nia/_data/faiss
# FAISS_INDEX_PATH=./data/faiss_index

# ── 基础设施 ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
MONGO_DB=nia

# ── CORS ──────────────────────────────────────────────────────────
# 前端开发服务器地址；生产环境改成实际域名，多个用逗号分隔。
# 留空会被当成 "*"（危险），因此请显式填写。
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# ── AI 配置 ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
AI_CACHE_DAYS=7
EXTRACTION_FAILURE_THRESHOLD=0.3
DOM_SIMILARITY_THRESHOLD=0.7
# RAG 检索相似度阈值，低于此值自动降级为普通聊天
RAG_THRESHOLD=0.3
# 检索命中条数
RAG_TOP_K=5

# ── 并发爬取引擎 ──────────────────────────────────────────────────
CRAWL_CONCURRENCY=8
CRAWL_LLM_CONCURRENCY=4
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=2
CRAWL_REQUEST_TIMEOUT=30
CRAWL_MAX_RETRIES=3
CRAWL_JS_CONCURRENCY=4
# 单页最大响应体（字节），防大文件/解压炸弹
CRAWL_MAX_CONTENT_BYTES=5242880
# 单域名并发上限（礼貌抓取）
CRAWL_PER_DOMAIN_CONCURRENCY=2
# 是否遵从 robots.txt
CRAWL_RESPECT_ROBOTS=true
# 同时运行的爬取任务数上限
MAX_CONCURRENT_CRAWLS=4

# ── 自主爬取 Agent ────────────────────────────────────────────────
AGENT_MAX_PAGES=30
AGENT_MAX_STEPS=20
AGENT_NO_PROGRESS_LIMIT=3
# 单次工具调用超时（秒）
AGENT_TOOL_TIMEOUT=180

# ── 监控 ──────────────────────────────────────────────────────────
# 当日成功率低于该值触发告警
ALERT_SUCCESS_RATE=90

# ── API 访问控制 ──────────────────────────────────────────────────
# 留空 = 不鉴权（仅建议本机使用）。部署到公网请设置一个随机串，
# 之后所有 /api/* 请求需带请求头:  X-API-Token: <值>
# API_AUTH_TOKEN=

# ── 前端静态托管（生产/Docker） ────────────────────────────────────
# 指向前端构建产物目录（含 index.html 与 assets/）。留空则只提供 API，
# 前端由 Vite 开发服务器或独立 Nginx 提供。Docker 镜像内固定为 /app/static。
# STATIC_DIR=./static
